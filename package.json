{
  "name": "@tobias-walle/superreview",
  "version": "0.2.1",
  "private": true,
  "description": "A local Git review workspace with permanent review history",
  "keywords": [
    "code-review",
    "diff",
    "git",
    "review"
  ],
  "homepage": "https://github.com/tobias-walle/superreview#readme",
  "bugs": {
    "url": "https://github.com/tobias-walle/superreview/issues"
  },
  "license": "MIT",
  "author": "Tobias Wagner",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobias-walle/superreview.git"
  },
  "bin": {
    "superreview": "dist-cli/superreview.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-cli.mjs --quiet && node dist-cli/superreview.mjs",
    "build": "node scripts/build-cli.mjs",
    "link:global": "pnpm run build && pnpm add --global .",
    "test": "pnpm run build && pnpm run test:review && pnpm run test:diff && pnpm run test:ui",
    "test:review": "node scripts/test-review.mjs",
    "test:diff": "node scripts/verify-diff.mjs && node --experimental-strip-types scripts/verify-review.mjs && node --experimental-strip-types scripts/verify-comments.mjs",
    "test:ui": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "check": "node --experimental-strip-types scripts/check.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "esbuild": "^0.28.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "postcss": "^8.5.6",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0"
}
